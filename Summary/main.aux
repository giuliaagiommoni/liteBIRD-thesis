\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:tod}{{\caption@xref {fig:tod}{ on input line 90}}{2}{Time and Frequency Domains Analysis}{figure.caption.5}{}}
\newlabel{sub@fig:tod}{{}{2}{Time and Frequency Domains Analysis}{figure.caption.5}{}}
\newlabel{fig:psd}{{\caption@xref {fig:psd}{ on input line 96}}{2}{Time and Frequency Domains Analysis}{figure.caption.5}{}}
\newlabel{sub@fig:psd}{{}{2}{Time and Frequency Domains Analysis}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Statistical validation of the noise models. Left: Time-Ordered Data (TOD) showing the characteristic low-frequency drifts of $1/f$ noise over a 1000s simulation. Right: Power Spectral Density (PSD) estimate showing the transition from the $f^{-\alpha }$ correlated regime to the white-noise plateau.}}{2}{figure.caption.5}\protected@file@percent }
\newlabel{fig:noise_comparison}{{1}{2}{Statistical validation of the noise models. Left: Time-Ordered Data (TOD) showing the characteristic low-frequency drifts of $1/f$ noise over a 1000s simulation. Right: Power Spectral Density (PSD) estimate showing the transition from the $f^{-\alpha }$ correlated regime to the white-noise plateau}{figure.caption.5}{}}
\newlabel{fig:tod}{{\caption@xref {fig:tod}{ on input line 113}}{2}{Map-Making and Harmonic Analysis}{figure.caption.7}{}}
\newlabel{sub@fig:tod}{{}{2}{Map-Making and Harmonic Analysis}{figure.caption.7}{}}
\newlabel{fig:psd}{{\caption@xref {fig:psd}{ on input line 119}}{2}{Map-Making and Harmonic Analysis}{figure.caption.7}{}}
\newlabel{sub@fig:psd}{{}{2}{Map-Making and Harmonic Analysis}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Spatial manifestation of instrumental noise. Left: HEALPix noise-only map generated from a one-year simulation, where the striation patterns reveal the projection of temporal correlations along the scanning strategy. Right: Angular power spectrum $C_\ell ^{TT}$ derived from the map, assuming no correction for $1/f$ noise in the map-making. The steep rise at low multipoles highlights the dominance of correlated noise on large angular scales. This low-multipole noise is usually cleaned at the map-level in data reduction pipelines; here we preserved it to highlight its potential impact on the power spectrum if not properly treated.}}{2}{figure.caption.7}\protected@file@percent }
\newlabel{fig:noise_comparison}{{2}{2}{Spatial manifestation of instrumental noise. Left: HEALPix noise-only map generated from a one-year simulation, where the striation patterns reveal the projection of temporal correlations along the scanning strategy. Right: Angular power spectrum $C_\ell ^{TT}$ derived from the map, assuming no correction for $1/f$ noise in the map-making. The steep rise at low multipoles highlights the dominance of correlated noise on large angular scales. This low-multipole noise is usually cleaned at the map-level in data reduction pipelines; here we preserved it to highlight its potential impact on the power spectrum if not properly treated}{figure.caption.7}{}}
